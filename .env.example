# Razorpay test-mode credentials
# Obtain these from your Razorpay Dashboard → Settings → API Keys (TEST mode)
RAZORPAY_KEY_ID=rzp_test_REPLACEME
RAZORPAY_KEY_SECRET=REPLACEME

# Razorpay webhook secret — configure in Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=REPLACEME

# SQLite database path (relative to project root)
# For PostgreSQL later: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./roe.db
